@model ProductCentral.FrontEnd.Models.ProductsController.DetailsViewModel

@{
    ViewData["Title"] = $"Product - {Model.Product?.Title}" ;
}

<h1>Product Details</h1>

<div>
    <h4>@Model.Product?.Title</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Description
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Product.Description)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Stock Quantity
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Product.StockQuantity)
        </dd>
    </dl>
    <dl class="row">
        <dt class="col-sm-2">
            Unit Price
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Product.UnitPrice)$
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index">Back to List</a>
</div>
